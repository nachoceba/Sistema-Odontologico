# Copiar a .env (cp .env.example .env) y completar JWT_SECRET_KEY. NUNCA commitear .env.
# Credenciales ficticias de desarrollo; los secretos reales van solo en .env.

# --- PostgreSQL (contenedor db) ---
POSTGRES_USER=odonto
POSTGRES_PASSWORD=odonto_dev
POSTGRES_DB=odonto

# --- Backend ---
DATABASE_URL=postgresql+psycopg://odonto:odonto_dev@db:5432/odonto
REDIS_URL=redis://redis:6379/0

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Minimo 32 caracteres. Sin valor, la API no arranca.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email (en desarrollo, Mailpit: sin credenciales ni TLS) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=turnos@ejemplo.com

# --- Consultorio y navegador ---
CLINIC_TIMEZONE=America/Argentina/Buenos_Aires
CORS_ORIGINS=http://localhost:5173

# --- Frontend (variable publica: nunca poner secretos con prefijo VITE_) ---
VITE_API_URL=http://localhost:8000/api/v1

# --- Base de datos de pruebas (C-02, solo tests de integracion) ---
# Base SEPARADA de la de desarrollo: su nombre DEBE terminar en _test (los tests se niegan a
# correr si no; ahi se borran datos). Mismo servidor y credenciales que POSTGRES_*.
TEST_DATABASE_URL=postgresql+psycopg://odonto:odonto_dev@db:5432/odonto_test

# --- Seed de datos de demostracion (C-02) ---
# Contrasena ficticia de las cuentas de demo (python -m scripts.seed). Si falta, el seed no corre.
# NUNCA usar esta en una demo publica (C-13 debe definir otra).
SEED_DEMO_PASSWORD=
