{
  "mcpServers": {
    "postgres-odonto": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "--network", "sistema-odontologico_default",
        "-e", "DATABASE_URI",
        "crystaldba/postgres-mcp",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://<usuario>:<contraseña>@db:5432/<base>"
      }
    }
  }
}
